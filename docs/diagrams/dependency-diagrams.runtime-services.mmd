end

subgraph Runtime["Cql.Runtime"]
direction TB
CqlContext["<b>CqlContext</b><br/><div style='text-align:left; max-width:280px; overflow-wrap:anywhere;'>Runtime execution context: holds the ICqlOperators implementation plus the input parameter dictionary for one CQL evaluation run.</div>"]
ICqlOperators["<b>ICqlOperators</b><br/><div style='text-align:left; max-width:280px; overflow-wrap:anywhere;'>Primary CQL runtime interface — all generated CQL libraries call through it for arithmetic, comparison, type-conversion, and data-access operations.</div>"]
CqlOperators["<b>CqlOperators</b><br/><div style='text-align:left; max-width:280px; overflow-wrap:anywhere;'>ICqlOperators implementation: dispatches arithmetic/comparison to CqlComparers and UnitConverter, routes cross-unit quantity operations through IMetricService, and delegates retrieves to IDataSource.</div>"]
CqlComparers["<b>CqlComparers</b><br/><div style='text-align:left; max-width:280px; overflow-wrap:anywhere;'>ICqlComparer implementation that dispatches to per-type comparers; its CqlQuantityCqlComparer uses IMetricService for cross-unit quantity comparisons.</div>"]
UnitConverter["<b>UnitConverter</b><br/><div style='text-align:left; max-width:280px; overflow-wrap:anywhere;'>IUnitConverter implementation that builds and caches unit-conversion functions on demand via IMetricService.TryConvertTo.</div>"]
IUnitConverter["<b>IUnitConverter</b><br/><div style='text-align:left; max-width:280px; overflow-wrap:anywhere;'>Abstraction for unit-conversion functions; injected into CqlOperators for ConvertQuantity and CanConvertQuantity operations.</div>"]
TypeConverter["<b>TypeConverter</b><br/><div style='text-align:left; max-width:280px; overflow-wrap:anywhere;'>Runtime value-conversion engine used to coerce values between CQL/.NET types.</div>"]
IDataSource["<b>IDataSource</b><br/><div style='text-align:left; max-width:280px; overflow-wrap:anywhere;'>Abstraction for the runtime data-access layer (retrieves, filters, and lookups over any backing store).</div>"]
CompositeDataSource["<b>CompositeDataSource</b><br/><div style='text-align:left; max-width:280px; overflow-wrap:anywhere;'>Empty IDataSource used as the default when no data source is supplied (all retrieves return empty).</div>"]
IValueSetDictionary["<b>IValueSetDictionary</b><br/><div style='text-align:left; max-width:280px; overflow-wrap:anywhere;'>Abstraction for value-set membership lookups during CQL evaluation.</div>"]
HashValueSetDictionary["<b>HashValueSetDictionary</b><br/><div style='text-align:left; max-width:280px; overflow-wrap:anywhere;'>Default in-memory IValueSetDictionary backed by a dictionary of code sets.</div>"]
DefaultUcumMetricService["<b>DefaultUcumMetricService</b><br/><div style='text-align:left; max-width:280px; overflow-wrap:anywhere;'>(internal) Default IMetricService that wraps FhirMetricService from Fhir.Metrics 1.4.0, used when FhirCqlContextOptions.MetricService is null.</div>"]
UcumConversionExtensionsDefault["<b>UcumConversionExtensions.Default</b><br/><div style='text-align:left; max-width:280px; overflow-wrap:anywhere;'>Static default IMetricService accessor used when the runtime is created without a custom metric-service override.</div>"]
end

