<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<!-- Use NuGet Package from the public Nuget feed -->
	<!-- <ItemGroup> -->
	<!-- 	<PackageReference Include="Hl7.Cql.Invocation" Version="2.1.0-alpha.18" /> -->
	<!-- </ItemGroup> -->

	<!-- OR, Use NuGet Package from the local build build-local-nuget.ps1, you'll need to update the version accordingly -->
	<!-- <ItemGroup> -->
	<!-- 	<PackageReference Include="Hl7.Cql.Invocation" Version="2.1.0-build.202506041535" /> -->
	<!-- </ItemGroup> -->

	<!-- OR, Use a direct project reference to the Cql.Invocation project, this is useful for debugging the library -->
	<ItemGroup>
		<ProjectReference Include="..\..\Cql\Cql.Invocation\Cql.Invocation.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="**\input\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Remove="bin\**\input\**;obj\**\input\**" />

		<Compile Remove="**\input\**\*.g.cs" />
		<!--
		  Generated C# an example WROTE must be excluded too, not just what it reads. Several examples
		  save .g.cs into their own output\cs directory, and the default glob would then compile it into
		  this project on the next build - producing duplicate types and members, since the same library
		  is already compiled from input. Without this, running the examples breaks the following build.
		-->
		<Compile Remove="**\output\**\*.g.cs" />
		<Compile Remove="bin\**;obj\**" />

		<None Include="**\input\**\*.g.cs">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Remove="bin\**\input\**\*.g.cs;obj\**\input\**\*.g.cs" />
	</ItemGroup>

	<Import Project="..\CqlSdkExamplesCodeGeneration.targets" />

</Project>