<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<!--
		The references below carry no Version because this repository manages package versions centrally,
		in the root Directory.Packages.props. To enable one, add a PackageVersion for Hl7.Cql.Invocation
		there naming the version you want.

		In your own project you have the same two choices: manage versions centrally the same way, or
		don't, and put Version="..." on the PackageReference itself.
		-->

	<!-- Use NuGet Package from the public Nuget feed -->
	<!-- <ItemGroup> -->
	<!-- 	<PackageReference Include="Hl7.Cql.Invocation" /> -->
	<!-- </ItemGroup> -->

	<!-- OR, Use NuGet Package from the local build build-local-nuget.ps1. Also uncomment the LocalPackages
	     source in NuGet.config, and give it a packageSourceMapping entry so Hl7.Cql.* resolves from it -->
	<!-- <ItemGroup> -->
	<!-- 	<PackageReference Include="Hl7.Cql.Invocation" /> -->
	<!-- </ItemGroup> -->

	<!-- OR, Use a direct project reference to the Cql.Invocation project, this is useful for debugging the library -->
	<ItemGroup>
		<ProjectReference Include="..\..\Cql\Cql.Invocation\Cql.Invocation.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="**\input\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Remove="bin\**\input\**;obj\**\input\**" />

		<!--
		  This project compiles no generated C#, wherever it sits. Examples both read .g.cs (from
		  input\cs) and write it (220, 221 and 222 save into their own output\cs), and the default glob
		  would compile it into this project - failing with CS0579 plus a run of CS0111/CS0102, because
		  the same libraries are already compiled from input. The written files are gitignored, so the
		  break appears out of nowhere and does not show in `git status`.

		  Deliberately one rule keyed on the .g.cs suffix rather than one per directory name: an
		  exclusion listing `input` and `output` has to be kept in step with wherever examples happen to
		  write next, and the example that saves to `generated\` reintroduces exactly this break. The
		  tracked .g.cs files under 230's input\cs are None-included below for copy-to-output, not
		  compiled, so nothing needs them on the Compile item.
		-->
		<Compile Remove="**\*.g.cs" />
		<Compile Remove="bin\**;obj\**" />

		<None Include="**\input\**\*.g.cs">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Remove="bin\**\input\**\*.g.cs;obj\**\input\**\*.g.cs" />
	</ItemGroup>

	<Import Project="..\CqlSdkExamplesCodeGeneration.targets" />

</Project>