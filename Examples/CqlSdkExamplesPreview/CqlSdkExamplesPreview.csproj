<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<!--
		The references below carry no Version because this repository manages package versions centrally,
		in the root Directory.Packages.props. To enable one, add a PackageVersion for Hl7.Cql.Invocation
		there naming the version you want.

		In your own project you have the same two choices: manage versions centrally the same way, or
		don't, and put Version="..." on the PackageReference itself.
		-->

	<!-- Use NuGet Package from the public Nuget feed -->
	<!-- <ItemGroup> -->
	<!-- 	<PackageReference Include="Hl7.Cql.Invocation" /> -->
	<!-- </ItemGroup> -->

	<!-- OR, Use NuGet Package from the local build build-local-nuget.ps1. Also uncomment the LocalPackages
	     source in NuGet.config, and give it a packageSourceMapping entry so Hl7.Cql.* resolves from it -->
	<!-- <ItemGroup> -->
	<!-- 	<PackageReference Include="Hl7.Cql.Invocation" /> -->
	<!-- </ItemGroup> -->

	<!-- OR, Use a direct project reference to the Cql.Invocation project, this is useful for debugging the library -->
	<ItemGroup>
		<ProjectReference Include="..\..\Cql\Cql.Invocation\Cql.Invocation.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="**\input\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Remove="bin\**\input\**;obj\**\input\**" />

		<Compile Remove="**\input\**\*.g.cs" />
		<Compile Remove="bin\**;obj\**" />

		<None Include="**\input\**\*.g.cs">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Remove="bin\**\input\**\*.g.cs;obj\**\input\**\*.g.cs" />
	</ItemGroup>

	<Import Project="..\CqlSdkExamplesCodeGeneration.targets" />

</Project>