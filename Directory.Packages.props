<Project>

	<!--
		=====================================================================================
		This file is the single source of truth for every external package version used by
		this repository. It is the only place to change one.
		=====================================================================================

		Projects declare packages without a version - <PackageReference Include="Foo" /> - and
		NuGet takes the version from the PackageVersion items below. A Version attribute on a
		PackageReference is an error (NU1008), which is what keeps this file authoritative.

		What does NOT live here:
		  - The SDK's own product version. VersionPrefix stays in cql-sdk.props and
		    Demo/cql-demo.props; it is the version we ship, not a version we consume.
		  - Versions for the private Firely.Cql.Sdk.Integration.Runner submodule, which opts
		    out via submodules/Directory.Packages.props. It is a separate repository.

		When you change a version here, also update the root README.md "External Dependencies"
		table, which is the only consumer-visible record of what we pin.

		This mirrors the arrangement in
		https://github.com/FirelyTeam/Vonk/blob/develop/Directory.Packages.props
		-->

	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<!--
		Version variables, used to keep related package versions in sync.
		Defined here rather than in cql-base.props for two reasons: Directory.Packages.props is
		imported before the project body, so the PackageVersion items below can reference them,
		and cql-base.props is imported explicitly by each project and so is evaluated too late.
		-->
	<PropertyGroup>
		<!--
			FirelyNetVersion must be at or above FhirNetApiVersion in Vonk's Directory.Packages.props
			by the time Vonk upgrades the CQL SDK: Hl7.Cql.Fhir declares Hl7.Fhir.Base >= this version,
			and Vonk pins Hl7.Fhir.Base directly, so a lower value there is a package downgrade.
			The CQL SDK legitimately leads for a while - Vonk moves to this version as part of taking
			the release that carries it - so the two being unequal between releases is expected.
			Keep in sync with the root README.md "External Dependencies" table.
			-->
		<FirelyNetVersion>6.5.0</FirelyNetVersion>
		<FhirMetricsVersion>1.4.0</FhirMetricsVersion>

		<!-- Keep MicrosoftCodeAnalysisVersion in sync with Vonk's property of the same name -->
		<MicrosoftCodeAnalysisVersion>5.3.0</MicrosoftCodeAnalysisVersion>

		<MicrosoftExtensionsVersion>10.0.3</MicrosoftExtensionsVersion>
		<MSTestVersion>3.8.3</MSTestVersion>
		<BenchmarkDotNetVersion>0.14.0</BenchmarkDotNetVersion>
		<SystemCommandLineVersion>2.0.0-beta4.22272.1</SystemCommandLineVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageVersion Include="Antlr4.Runtime.Standard" Version="4.13.1" />
		<PackageVersion Include="BenchmarkDotNet" Version="$(BenchmarkDotNetVersion)" />
		<PackageVersion Include="BenchmarkDotNet.Diagnostics.Windows" Version="$(BenchmarkDotNetVersion)" />
		<PackageVersion Include="CommandLineParser" Version="2.9.1" />
		<PackageVersion Include="coverlet.collector" Version="6.0.2" />
		<PackageVersion Include="Fhir.Metrics" Version="$(FhirMetricsVersion)" />
		<PackageVersion Include="FluentAssertions" Version="7.2.0" />
		<PackageVersion Include="Hl7.Fhir.Base" Version="$(FirelyNetVersion)" />
		<PackageVersion Include="Hl7.Fhir.R4" Version="$(FirelyNetVersion)" />
		<PackageVersion Include="JetBrains.Annotations" Version="2024.3.0" />
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="$(MicrosoftCodeAnalysisVersion)" />
		<PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="4.14.0" />
		<PackageVersion Include="Microsoft.Extensions.Configuration" Version="$(MicrosoftExtensionsVersion)" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="$(MicrosoftExtensionsVersion)" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.CommandLine" Version="$(MicrosoftExtensionsVersion)" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(MicrosoftExtensionsVersion)" />
		<PackageVersion Include="Microsoft.Extensions.FileSystemGlobbing" Version="$(MicrosoftExtensionsVersion)" />
		<PackageVersion Include="Microsoft.Extensions.Hosting" Version="$(MicrosoftExtensionsVersion)" />
		<PackageVersion Include="Microsoft.Extensions.Logging" Version="$(MicrosoftExtensionsVersion)" />
		<!--
			Deliberately NOT $(MicrosoftExtensionsVersion): this package is pinned at 10.0.7 while the
			rest of the Microsoft.Extensions.* family is at 10.0.3. Recorded as-is so that adopting
			central package management changes no resolved version. Whether the family should be
			unified is a separate question - see https://github.com/FirelyTeam/firely-cql-sdk/issues/1614
			-->
		<PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.7" />
		<PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="$(MicrosoftExtensionsVersion)" />
		<PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="$(MicrosoftExtensionsVersion)" />
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
		<PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
		<PackageVersion Include="MSTest" Version="4.0.1" />
		<PackageVersion Include="MSTest.TestAdapter" Version="$(MSTestVersion)" />
		<PackageVersion Include="MSTest.TestFramework" Version="$(MSTestVersion)" />
		<PackageVersion Include="Serilog.Extensions.Logging" Version="9.0.1" />
		<PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageVersion Include="System.CodeDom" Version="8.0.0" />
		<PackageVersion Include="System.CommandLine" Version="$(SystemCommandLineVersion)" />
		<PackageVersion Include="System.CommandLine.NamingConventionBinder" Version="$(SystemCommandLineVersion)" />
	</ItemGroup>

</Project>
