<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<packageSources>
		<!--
			<clear /> drops any sources inherited from machine- or user-level NuGet.config files, so
			restore resolves against exactly the sources listed here and nowhere else. Required by
			central package management, which reports NU1507 when more than one source is configured
			and no source mapping exists - and that count includes a developer's personal feeds, so
			without this the build succeeds or fails depending on whose machine it runs on.
			-->
		<clear />
		<!-- Local package source (when building NuGet packages into the .\nupkgs folder and referencing them instead, should not be uncommented in production code) -->
		<!-- <add key="LocalPackages" value=".\.nupkgs" /> -->
		<!-- Other sources like nuget.org -->
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
	</packageSources>

	<!--
		Every package this repository consumes is public and comes from nuget.org. Stating that
		explicitly is what central package management asks for in place of NU1507, and it means a
		package cannot be silently picked up from a feed this repository does not declare.
		-->
	<packageSourceMapping>
		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>
	</packageSourceMapping>
</configuration>