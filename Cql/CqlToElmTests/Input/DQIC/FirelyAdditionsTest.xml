<?xml version="1.0" encoding="utf-8"?>
<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://hl7.org/fhirpath/tests" xsi:schemaLocation="http://hl7.org/fhirpath/tests ../../testSchema/testSchema.xsd"
	name="FirelyAdditionsTest" reference="https://cql.hl7.org/09-b-cqlreference.html#string-operators-3">
	<group name="Combine">
		<test name="CombineWithNulls">
			<expression>Combine({'A', 'B', 'C', null})</expression>
			<output>'ABC'</output>
		</test>
	</group>
	<group name="EndsWith">
		<test name="EndsWithEmptySuffix">
			<expression>EndsWith('ABC', '')</expression>
			<output>true</output>
		</test>
		<test name="EndsWithSuffixLongerThanArgument">
			<expression>EndsWith('ABC', 'ABCDEFG')</expression>
			<output>false</output>
		</test>
		<test name="EndsWithIsTrue">
			<expression>EndsWith('ABC', 'C')</expression>
			<output>true</output>
		</test>
		<test name="EndsWithIsFalse">
			<expression>EndsWith('ABC', 'Z')</expression>
			<output>false</output>
		</test>
	</group>
	<group name="Split">
		<test name="SplitMultiCharacterSeparator">
			<expression>Split('A--B--C', '--')</expression>
			<output>{'A','B','C'}</output>
		</test>
		<test name="SplitMultiCharacterSeparatorPartialMatch">
			<expression>Split('A::B:C', '::')</expression>
			<output>{'A','B:C'}</output>
		</test>
		<test name="SplitSeparatorNotFound">
			<expression>Split('abc', 'xyz')</expression>
			<output>{'abc'}</output>
		</test>
	</group>
</tests>
