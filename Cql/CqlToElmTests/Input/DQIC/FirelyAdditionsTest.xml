<?xml version="1.0" encoding="utf-8"?>
<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://hl7.org/fhirpath/tests" xsi:schemaLocation="http://hl7.org/fhirpath/tests ../../testSchema/testSchema.xsd"
	name="FirelyAdditionsTest" reference="https://cql.hl7.org/09-b-cqlreference.html#string-operators-3">
	<group name="Combine">
		<test name="CombineWithNulls">
			<expression>Combine({'A', 'B', 'C', null})</expression>
			<output>'ABC'</output>
		</test>
	</group>
	<group name="EndsWith">
		<test name="EndsWithEmptySuffix">
			<expression>EndsWith('ABC', '')</expression>
			<output>true</output>
		</test>
		<test name="EndsWithSuffixLongerThanArgument">
			<expression>EndsWith('ABC', 'ABCDEFG')</expression>
			<output>false</output>
		</test>
		<test name="EndsWithIsTrue">
			<expression>EndsWith('ABC', 'C')</expression>
			<output>true</output>
		</test>
		<test name="EndsWithIsFalse">
			<expression>EndsWith('ABC', 'Z')</expression>
			<output>false</output>
		</test>
	</group>
	<group name="Split">
		<test name="SplitMultiCharacterSeparator">
			<expression>Split('A--B--C', '--')</expression>
			<output>{'A','B','C'}</output>
		</test>
		<test name="SplitMultiCharacterSeparatorPartialMatch">
			<expression>Split('A::B:C', '::')</expression>
			<output>{'A','B:C'}</output>
		</test>
		<test name="SplitSeparatorNotFound">
			<expression>Split('abc', 'xyz')</expression>
			<output>{'abc'}</output>
		</test>
	</group>
	<group name="AvgQuantity">
		<test name="AvgQuantity">
			<expression>Avg({ 5.5 'cm', 4.7 'cm', 4.8 'cm' })</expression>
			<output>5.0 'cm'</output>
		</test>
		<test name="AvgQuantityNullElements">
			<expression>Avg({ 1.0 'cm', null, 3.0 'cm' })</expression>
			<output>2.0 'cm'</output>
		</test>
		<test name="AvgQuantityAllNull">
			<expression>Avg({ null as Quantity, null as Quantity })</expression>
			<output>null</output>
		</test>
		<test name="AvgQuantityIsNull">
			<expression>Avg(null as List&lt;Quantity&gt;)</expression>
			<output>null</output>
		</test>
	</group>
	<group name="MedianQuantity">
		<test name="MedianQuantityOdd">
			<expression>Median({ 1.0 'mg', 2.0 'mg', 3.0 'mg' })</expression>
			<output>2.0 'mg'</output>
		</test>
		<test name="MedianQuantityEven">
			<expression>Median({ 4.0 'mg', 1.0 'mg', null, 2.0 'mg', 3.0 'mg' })</expression>
			<output>2.5 'mg'</output>
		</test>
		<test name="MedianQuantityIsNull">
			<expression>Median(null as List&lt;Quantity&gt;)</expression>
			<output>null</output>
		</test>
	</group>
</tests>
