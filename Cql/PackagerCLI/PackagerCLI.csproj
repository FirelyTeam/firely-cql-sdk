<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="..\..\cql-sdk.props" />

	<PropertyGroup>
		<CqlSolutionDir>$(MSBuildProjectDirectory)/../../</CqlSolutionDir>
		<DqmContentQiCoreLibrarySetDir>$(CqlSolutionDir)/LibrarySets/dqm-content-qicore-2025/</DqmContentQiCoreLibrarySetDir>
		<RR23LibrarySetDir>$(CqlSolutionDir)/LibrarySets/RR23/</RR23LibrarySetDir>
		<DemoLibrarySetDir>$(CqlSolutionDir)/LibrarySets/Demo/</DemoLibrarySetDir>
		<NcqaBuildArtifactsDir>$(CqlSolutionDir)/submodules/Ncqa.DQIC/BuildArtifacts/</NcqaBuildArtifactsDir>
		<Hedis2025StagingDir>D:/firely-dqm-libraries/workspace/HEDIS/2025/staging</Hedis2025StagingDir>
		<MeasuresAuthoringDemoDir>$(CqlSolutionDir)/Demo/Measures.Authoring/</MeasuresAuthoringDemoDir>
		<MeasuresDemoDir>$(CqlSolutionDir)/Demo/Measures.Demo/</MeasuresDemoDir>
		<MeasuresDqmContentQiCoreDemoDir>$(CqlSolutionDir)/Demo/Measures.dqm-content-qicore-2025/</MeasuresDqmContentQiCoreDemoDir>
		<CoreTestsDir>$(CqlSolutionDir)/Cql/CoreTests/</CoreTestsDir>

		<OutputType>Exe</OutputType>
		<ImplicitUsings>enable</ImplicitUsings>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>cql-package</ToolCommandName>
		<RootNamespace>Hl7.Cql.Packager</RootNamespace>
		<AssemblyName>Hl7.Cql.Packager</AssemblyName>
		<Product>dotnet tool for packaging CQL artifacts</Product>
		<Description>.NET tool that packages CQL, ELM and build outputs into a FHIR Library resource.</Description>
		<Configurations>Debug;Release</Configurations>
	</PropertyGroup>

	<!-- ignore sdk warnings -->
	<PropertyGroup>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting" />
		<PackageReference Include="Microsoft.Extensions.Configuration" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" />
		<PackageReference Include="Serilog.Extensions.Logging" />
		<PackageReference Include="Serilog.Sinks.File" />
		<PackageReference Include="Hl7.Fhir.R4" />
		<PackageReference Include="System.CommandLine" />
		<PackageReference Include="System.CommandLine.NamingConventionBinder" />
		<PackageReference Remove="Microsoft.CodeAnalysis.PublicApiAnalyzers" />
	</ItemGroup>

	<ItemGroup>
	  <Content Include="Hl7.Cql.Packager.dqm-content-qicore-2025.appsettings.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="Hl7.Cql.Packager.appsettings.debug.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="Hl7.Cql.Packager.appsettings.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="Hl7.Cql.Packager.Demo.appsettings.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="CoreTests" Key="$(LibraryPKHash)" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Cql.Packaging\Cql.Packaging.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="PackagerOptions.*.cs">
			<DependentUpon>PackagerOptions.cs</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<Compile Update="CqlPackagingPipelineOptions.*.cs">
			<DependentUpon>CqlPackagingPipelineOptions.cs</DependentUpon>
		</Compile>
	</ItemGroup>

</Project>
