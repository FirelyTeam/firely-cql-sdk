{
  "Logging": {
    "ConsoleLogLevel": "Information", // --console-log-level "Trace", "Debug", "Information", "Warning", "Error", "Critical" or "None"
    "FileLogLevel": "Information", // --file-log-level "Trace", "Debug", "Information", "Warning", "Error", "Critical" or "None"
    "Append": false, // --log-append
  },
  "Cql": {
    "Models": [ "ElmR1", "Fhir401" ], // any of "ElmR1", "Fhir401", "USCore311", "QICore411", "USCore610" or "QICore600"
    "AmbiguousTypeBehavior": "PreferModel", // "Error", "PreferSystem" or "PreferModel"
    "SystemElmModelUri": "urn:hl7-org:elm-types:r1",
    "SystemElmModelVersion": "1.0.0",
    "DisableListDemotion": true,
    "DisableListPromotion": true,
    "EnableIntervalDemotion": true,
    "EnableIntervalPromotion": true,
    "AllowNullIntervals": true,
    "ValidateIntervals": false,
    "LongsRequireSuffix": true,
    "ValidateLiterals": true
  },
  "Elm": {
    "AllowInvalidCSharp": true,
    "JsonPretty": false, // --json-pretty
    "DebugSymbolsFormat": "None", // --debug-symbols : "None", "PortablePdb", "Embedded"
    "CSharpNamespace": null, // --cs-namespace : The C# namespace to use for generated code (e.g., "MyCompany.MyCqlLibraries")
    "SkipFiles": [
      // JSON Files that are skipped during the packaging process.
      // See the specific profile appsettings e.g. Hl7.Cql.Packager.appsettings.CMSMeasures.json
    ]
  },
  "Packaging": {
    "JsonPretty": false, // --json-pretty : indentation of the FHIR resource JSON that is written out
    // Formatting of the ELM JSON embedded as the application/elm+json attachment:
    //   "Passthrough" (default) embeds the ELM as it was read, without reformatting it.
    //   "Indented"    formats the ELM JSON with indentation.
    //   "Compact"     formats the ELM JSON without indentation, for a smaller attachment.
    // All three change formatting only, reusing the JSON a library was read from rather than rebuilding
    // it from the ELM graph. That reused JSON keeps empty collections and lacks the normalizations
    // serializing applies (explicit accessLevel, resultTypeSpecifier derived from a legacy "type").
    // All three normalize line endings to LF so the attachment does not depend on the checkout.
    "ElmAttachmentFormatting": "Passthrough",
    "ExitOnError": false,
    "CanonicalRootUrl": "https://fire.ly/fhir/", // --canonical-root-url
    "OverrideDate": null, // --override-utc-date-time eg. "2023-10-01T00:00:00Z",
    "FixedLibraryCanonicals": {
      "FHIRHelpers": "http://hl7.org/fhir/uv/cql/Library/FHIRHelpers"
    }
  }
}